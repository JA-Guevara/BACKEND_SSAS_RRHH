# Normalización de finales de línea: el repositorio guarda LF siempre.
* text=auto eol=lf

# Binarios: nunca tocar
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary
*.xlsx binary
*.docx binary

# Scripts que deben conservar CRLF en Windows
*.bat text eol=crlf
*.cmd text eol=crlf
