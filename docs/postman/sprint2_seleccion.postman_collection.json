    },
    {
      "name": "Reintentar contratar (mismo codigo)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/postulaciones/{{postulacion_id}}/contratar",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"{{codigo_empleado}}\",\n  \"apellido_paterno\": \"Demo\",\n  \"apellido_materno\": \"\",\n  \"ci_expedido\": \"LP\",\n  \"fecha_ingreso\": \"{{fecha_ingreso}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Mismo empleado', () => pm.expect(pm.response.json().id).to.eql(pm.variables.get('empleado_id')));"
            ]
          }
        }
      ]
    },
    {
      "name": "Empleados",
