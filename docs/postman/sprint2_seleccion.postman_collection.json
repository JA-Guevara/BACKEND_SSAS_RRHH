    {
      "name": "Comparar finalistas",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/vacantes/{{vacante_id}}/comparar",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"postulacion_ids\": [\n    \"{{postulacion_id}}\",\n    \"{{postulacion_2_id}}\"\n  ]\n}",
          "options": {
