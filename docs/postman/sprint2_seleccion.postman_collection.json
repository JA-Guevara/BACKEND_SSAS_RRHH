            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/postulaciones/{{postulacion_id}}/evaluaciones",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo\": \"TECNICA\",\n  \"nombre\": \"Postman SQL\",\n  \"puntaje\": 18,\n  \"puntaje_maximo\": 20,\n  \"aprobado\": true,\n  \"observaciones\": \"Demostracion sintetica\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
