{
  "info": {
    "name": "Sprint2 seleccion local",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Solo backend local desechable. Configurar variables con cargar_sprint2_demo. Mutaciones requieren allow_writes=true. Resultado requiere entrevista ya iniciada."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8012/api/v1"
    },
    {
      "key": "allow_writes",
      "value": "false"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "empresa_slug",
      "value": ""
    },
    {
      "key": "empresa_id",
      "value": ""
    },
    {
      "key": "vacante_id",
      "value": ""
    },
    {
      "key": "postulacion_id",
      "value": ""
    },
    {
      "key": "postulacion_2_id",
      "value": ""
    },
    {
      "key": "postulante_id",
      "value": ""
    },
    {
      "key": "entrevistador_id",
      "value": ""
    },
    {
      "key": "entrevista_id",
      "value": ""
    },
    {
      "key": "evaluacion_id",
      "value": ""
    },
    {
      "key": "empleado_id",
      "value": ""
    },
    {
      "key": "fecha_entrevista",
      "value": ""
    },
    {
      "key": "fecha_ingreso",
      "value": ""
    },
    {
      "key": "codigo_empleado",
      "value": "DEMO-POSTMAN-001"
    },
    {
      "key": "codigo_seguimiento",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const base = pm.variables.get('base_url');",
          "if (!/^http:\\/\\/(127\\.0\\.0\\.1|localhost):\\d+\\/api\\/v1$/.test(base || '')) { throw new Error('Only local disposable backend URLs are allowed'); }",
          "if (pm.request.method !== 'GET' && pm.variables.get('allow_writes') !== 'true') { throw new Error('Set allow_writes=true only for the disposable local demo'); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Agenda",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/entrevistas?limit=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Opciones",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/entrevistas/opciones"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Programar entrevista",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/entrevistas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"postulacion_id\": \"{{postulacion_id}}\",\n  \"entrevistador_id\": \"{{entrevistador_id}}\",\n  \"tipo\": \"TELEFONICA\",\n  \"modalidad\": \"TELEFONICA\",\n  \"fecha_hora\": \"{{fecha_entrevista}}\",\n  \"duracion_min\": 45,\n  \"enlace_reunion\": \"\",\n  \"lugar\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('entrevista_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Detalle entrevista",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/entrevistas/{{entrevista_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Confirmar entrevista",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/entrevistas/{{entrevista_id}}/estado",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado\": \"CONFIRMADA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Resultado (despues de la fecha)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/entrevistas/{{entrevista_id}}/resultado",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"puntaje\": 90,\n  \"observaciones\": \"Evaluacion de demostracion\",\n  \"recomendacion\": \"APTO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Evaluaciones",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/postulaciones/{{postulacion_id}}/evaluaciones"
      },
      "event": [
        {
          "listen": "test",
