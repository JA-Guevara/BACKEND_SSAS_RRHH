APP_ENV=development
APP_DEBUG=false
APP_SECRET_KEY=replace-with-a-random-secret
APP_ALGORITHM=HS256
APP_ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_REFRESH_TOKEN_EXPIRE_DAYS=7
APP_PASSWORD_RESET_EXPIRE_MINUTES=30
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
