APP_ENV=development
APP_DEBUG=false
APP_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
APP_ALGORITHM=HS256
APP_ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_REFRESH_TOKEN_EXPIRE_DAYS=7
APP_PASSWORD_RESET_EXPIRE_MINUTES=30
APP_EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
APP_MAX_LOGIN_ATTEMPTS=5
APP_LOGIN_LOCK_MINUTES=15
APP_FRONTEND_URL=http://localhost:3000
APP_CORS_ORIGINS=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SSAS RRHH
SMTP_USE_TLS=true
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
