# ── Aplicación ───────────────────────────────────────────────────────────────
APP_ENV=development                 # development | production
APP_DEBUG=false                     # true solo en local: expone el reset_token en la respuesta
APP_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
APP_ALGORITHM=HS256
APP_ACCESS_TOKEN_EXPIRE_MINUTES=15
APP_REFRESH_TOKEN_EXPIRE_DAYS=7
APP_PASSWORD_RESET_EXPIRE_MINUTES=30
APP_EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
APP_MAX_LOGIN_ATTEMPTS=5
APP_LOGIN_LOCK_MINUTES=15

# ── Frontend ─────────────────────────────────────────────────────────────────
# Las dos son necesarias y NO son intercambiables, aunque hoy valgan lo mismo:
#   APP_FRONTEND_URL  -> arma los enlaces que van DENTRO de los correos
#                        ({url}/restablecer-contrasena?token=..., /verificar-correo?token=...)
#   APP_CORS_ORIGINS  -> lista blanca del navegador. Acepta varios separados por coma.
APP_FRONTEND_URL=http://localhost:3000
APP_CORS_ORIGINS=http://localhost:3000

# ── Correo ───────────────────────────────────────────────────────────────────
# Sin SMTP_HOST no se envían correos: el alta de empresa igual funciona, pero el
# administrador inicial no recibe el enlace de verificación.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SSAS RRHH
SMTP_USE_TLS=true

# ── Base de datos ────────────────────────────────────────────────────────────
# Acepta postgres://, postgresql:// o postgresql+psycopg://
# En Railway: referenciar ${{Postgres.DATABASE_URL}} en vez de escribirla a mano.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
DB_ECHO=false                       # true vuelca el SQL con parámetros: nunca en producción
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
